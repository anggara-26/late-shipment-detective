# ---- Runtime ----
# true  = run on the bundled synthetic TPC-H-shaped sample instead of Zetaris (no credentials needed)
SAMPLE_MODE=false
# true  = skip Nightshift and use deterministic fallbacks (for judges without Nightshift)
LLM_OFFLINE=false
MAX_HYPOTHESES=6

# ---- Zetaris (data layer) ----
# api   = REST API on :8888 (Participant Setup Guide 1.9)
# proxy = web UI proxy on :3000 (zetaris/getting-started scripts) -> set ZETARIS_REST_URL=http://localhost:3000
ZETARIS_MODE=api
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
# Prefix of the TPC-H tables, found with `npm run discover` (TPCH. after `npm run load-tpch`)
ZETARIS_TABLE_PREFIX=
ZETARIS_TIMEOUT_MS=120000

# ---- Meterless Nightshift (primary AI provider) ----
# From Nightshift -> Console. The NVIDIA key lives in Nightshift's Providers tab, NOT here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
# Routing mode or a concrete Nemotron id from Nightshift's model list
METERLESS_MODEL=meterless/auto
# Optional deeper lane for the Skeptic and Writer (e.g. meterless/deep or a larger Nemotron)
METERLESS_DEEP_MODEL=
